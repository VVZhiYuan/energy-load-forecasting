# The Agent is intentionally disabled on the company computer.
ENERGY_AI_PROVIDER=disabled

# For a hosted or local OpenAI-compatible endpoint, change these values.
ENERGY_AI_BASE_URL=https://api.example.com/v1
ENERGY_AI_MODEL=your-model-name
ENERGY_AI_API_KEY=

# Remote hosts must be explicitly allowlisted; leave unset for local/offline use.
# ENERGY_AI_ALLOWED_HOSTS=api.example.com
# ENERGY_AI_TIMEOUT_SECONDS=30
# ENERGY_AI_MAX_RESPONSE_BYTES=65536
